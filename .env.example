# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible router settings (use chat for 9router).
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_API_STYLE=chat
# OPENAI_MODEL=ag/gemini-3-flash
# OPENAI_MAX_OUTPUT_TOKENS=2048
